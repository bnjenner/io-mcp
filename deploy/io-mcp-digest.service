# systemd *user* oneshot for the nightly paper digest (paired with the .timer).
# Rendered + installed by deploy/install.sh --timer.

[Unit]
Description=io-mcp nightly paper digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
ExecStart=@IO_MCP_BIN@ digest
# A free Semantic Scholar API key avoids the shared unauthenticated 429s.
# Get one at https://www.semanticscholar.org/product/api#api-key then uncomment:
# Environment=SEMANTIC_SCHOLAR_API_KEY=your-key-here
